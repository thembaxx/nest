# Connect a free Neon database to the Vercel project; never use NEXT_PUBLIC_ here.
DATABASE_URL=
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Optional: Google OAuth Web application client ID (public; never a client secret).
# Enable the Drive API and allow each exact app origin in Google Auth Platform.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional public canonical origin; set this when connecting a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
