# Connect a free Neon database to the Vercel project; never use NEXT_PUBLIC_ here.
DATABASE_URL=
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Optional Google Drive sync: a public Google OAuth Web client ID, never a client secret.
# Enable Drive API and authorize each exact app origin in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional public canonical origin; set this when connecting a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
